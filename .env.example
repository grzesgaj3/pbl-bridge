# pbl-api base URL (no trailing slash needed)
API_URL=http://127.0.0.1:8000
# Bridge API key issued by: python -m app.scripts.create_bridge <bridge_id>
API_KEY=replace-me
# Serial port and baud rate
SERIAL_PORT=/dev/serial0
SERIAL_BAUD=9600
# Polling interval for flushing the queue and checking cleaning commands (seconds)
POLL_INTERVAL_SEC=30
# Offline queue files
MEASUREMENTS_QUEUE_FILE=measurements_queue.jsonl
PENDING_ACKS_FILE=pending_acks.json
# HTTP timeout for API calls (seconds)
HTTP_TIMEOUT_SEC=10
# Logging level: debug, info, warning, error
LOG_LEVEL=info
